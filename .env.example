# =========================================================
# CyberLens - ملف الإعدادات النموذجي
# =========================================================
# انسخ هذا الملف وسمّه ".env" ثم املأ القيم.
# ملف .env يجب ألا يُرفع لأي مستودع Git إطلاقًا.
# =========================================================


# ---------------------------------------------------------
# 1) المفتاح السري - مطلوب في الإنتاج
# ---------------------------------------------------------
# التطبيق يرفض الإقلاع بدونه خارج وضع التطوير، لأن من
# يعرف المفتاح يستطيع تزوير كوكي الجلسة وانتحال أي حساب.
# ولّده بالأمر:
#   python -c "import secrets; print(secrets.token_hex(32))"
CYBERLENS_SECRET_KEY=


# ---------------------------------------------------------
# 2) حساب المدير الأول - مطلوب لإنشاء أول مستخدم
# ---------------------------------------------------------
# لا توجد بيانات اعتماد افتراضية في الكود. إن تُركت هذه
# المتغيرات فارغة لن يُنشأ أي حساب ولن تتمكن من الدخول.
# كلمة المرور يجب ألا تقل عن 12 محرفًا.
CYBERLENS_ADMIN_USERNAME=
CYBERLENS_ADMIN_PASSWORD=


# ---------------------------------------------------------
# 3) قاعدة البيانات - اختياري
# ---------------------------------------------------------
# اتركه فارغًا لاستخدام SQLite محليًا في data/cyberlens.db
# أو ضع رابط PostgreSQL للإنتاج.
DATABASE_URL=


# ---------------------------------------------------------
# 4) مفاتيح الذكاء الاصطناعي - اختيارية بالكامل
# ---------------------------------------------------------
# ترتيب الأولوية:
#   1) Groq   إن وُجد GROQ_API_KEY واشتغل
#   2) Gemini إن فشل Groq ووُجد GEMINI_API_KEY
#   3) المحلل المحلي تلقائيًا - لا يحتاج أي إعداد

# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash


# ---------------------------------------------------------
# 5) إعدادات الخادم - اختيارية
# ---------------------------------------------------------
# HOST الافتراضي 127.0.0.1. لا تضعه 0.0.0.0 إلا إذا كنت
# تقصد فعلًا كشف الخادم على الشبكة.
# PORT=5000
# HOST=127.0.0.1

# FLASK_DEBUG=true يفعّل مصحّح Werkzeug الذي يسمح بتنفيذ
# أوامر عن بُعد. للتطوير المحلي فقط، لا تفعّله في الإنتاج.
# FLASK_DEBUG=false
